@inject ApiService Api
@inject ToastService Toast

<div class="tab-content">
    <div class="tab-header">
        <h2>Customers</h2>
        <button class="add-btn" @onclick="OpenCreateModal">➕ Create Customer</button>
    </div>

    @if (isLoading)
    {
        <p>Loading customers...</p>
    }
    else if (customers == null || !customers.Any())
    {
        <p>No customers found.</p>
    }
    else
    {
        <div class="table-info-bar">
            <span class="record-count">Showing @FilteredCustomers.Count() of @customers.Count records</span>
            @if (HasActiveFilters)
            {
                <button class="clear-filters-btn" @onclick="ClearFilters">Clear Filters</button>
            }
        </div>
        <table class="sortable-table">
            <thead>
                <tr>
                    <th class="sortable" @onclick='() => Sort("Name")'>
                        <span class="sort-header">Name <span class="sort-icon @GetSortClass("Name")"></span></span>
                    </th>
                    <th class="sortable" @onclick='() => Sort("Description")'>
                        <span class="sort-header">Description <span class="sort-icon @GetSortClass("Description")"></span></span>
                    </th>
                    <th>Actions</th>
                </tr>
                <tr class="filter-row">
                    <th><input type="text" class="filter-input" placeholder="Filter..." @bind="filterByName" @bind:event="oninput" /></th>
                    <th><input type="text" class="filter-input" placeholder="Filter..." @bind="filterByDescription" @bind:event="oninput" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in FilteredCustomers)
                {
                    <tr>
                        <td>@customer.Name</td>
                        <td>@customer.Description</td>
                        <td>
                            <button class="edit-btn" @onclick="() => OpenEditModal(customer)">Edit</button>
                            <button class="delete-btn" @onclick="() => DeleteCustomer(customer.Name)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(isEditMode ? "Edit Customer" : "Create Customer")</h3>
                <button class="close-btn" @onclick="CloseModal">✖</button>
            </div>
            <EditForm Model="@customerForm" OnValidSubmit="SubmitCustomerForm">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label>Name:</label>
                    <InputText @bind-Value="customerForm.Name" class="form-control" disabled="@isEditMode" />
                </div>
                <div class="form-group">
                    <label>Description:</label>
                    <InputText @bind-Value="customerForm.Description" class="form-control" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="cancel-btn" @onclick="CloseModal">Cancel</button>
                    <button type="submit" class="submit-btn" disabled="@isSubmitting">
                        @(isEditMode ? "Update" : "Create")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Customer> customers = new();
    private CreateCustomerRequest customerForm = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showModal = false;
    private bool isEditMode = false;

    // Sorting
    private string sortColumn = "Name";
    private bool sortAscending = true;

    // Filtering
    private string filterByName = "";
    private string filterByDescription = "";

    private bool HasActiveFilters => !string.IsNullOrEmpty(filterByName) || !string.IsNullOrEmpty(filterByDescription);

    private IEnumerable<Customer> FilteredCustomers
    {
        get
        {
            var result = customers.AsEnumerable();

            if (!string.IsNullOrEmpty(filterByName))
                result = result.Where(c => c.Name?.Contains(filterByName, StringComparison.OrdinalIgnoreCase) == true);
            if (!string.IsNullOrEmpty(filterByDescription))
                result = result.Where(c => c.Description?.Contains(filterByDescription, StringComparison.OrdinalIgnoreCase) == true);

            result = sortColumn switch
            {
                "Name" => sortAscending ? result.OrderBy(c => c.Name) : result.OrderByDescending(c => c.Name),
                "Description" => sortAscending ? result.OrderBy(c => c.Description) : result.OrderByDescending(c => c.Description),
                _ => result
            };

            return result;
        }
    }

    private void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string GetSortClass(string column)
    {
        if (sortColumn != column) return "none";
        return sortAscending ? "active asc" : "active desc";
    }

    private void ClearFilters()
    {
        filterByName = "";
        filterByDescription = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        isLoading = true;
        try
        {
            customers = await Api.GetCustomers() ?? new();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load customers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        customerForm = new();
        isEditMode = false;
        showModal = true;
    }

    private void OpenEditModal(Customer customer)
    {
        customerForm = new CreateCustomerRequest
        {
            Name = customer.Name,
            Description = customer.Description
        };
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        customerForm = new();
    }

    private async Task SubmitCustomerForm()
    {
        isSubmitting = true;
        try
        {
            if (isEditMode)
            {
                await Api.UpdateCustomer(customerForm.Name, customerForm);
                await Toast.ShowSuccess("Customer updated");
            }
            else
            {
                await Api.CreateCustomer(customerForm);
                await Toast.ShowSuccess("Customer created");
            }
            CloseModal();
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to save customer: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteCustomer(string name)
    {
        try
        {
            await Api.DeleteCustomer(name);
            await Toast.ShowSuccess("Customer deleted");
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to delete customer: {ex.Message}");
        }
    }
}
