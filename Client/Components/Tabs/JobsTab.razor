@inject ApiService Api
@inject ToastService Toast
@implements IDisposable

<div class="tab-content">
    <div class="tab-header">
        <h2>Jobs</h2>
        <button class="add-btn" @onclick="OpenCreateModal">➕ Create Job</button>
    </div>

    @if (isLoading)
    {
        <p>Loading jobs...</p>
    }
    else if (jobs == null || !jobs.Any())
    {
        <p>No jobs found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Image</th>
                    <th>Schedule</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in jobs)
                {
                    var statusClass = job.Status switch
                    {
                        "Pending" => "status-pending",
                        "Running" => "status-running",
                        "Completed" => "status-completed",
                        "Failed" => "status-failed",
                        _ => ""
                    };
                    var statusText = job.Status switch
                    {
                        "Pending" => "⏳ Pending",
                        "Running" => "▶️ Running",
                        "Completed" => "✓ Completed",
                        "Failed" => "✗ Failed",
                        _ => "Unknown"
                    };
                    <tr>
                        <td>@job.Id.ToString().Substring(0, 8)</td>
                        <td>@job.Customer</td>
                        <td>@job.Name</td>
                        <td><span class="status-badge @statusClass">@statusText</span></td>
                        <td>@job.ContainerImage</td>
                        <td>@(job.Schedule ?? "One-time")</td>
                        <td>@job.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <button class="view-btn" @onclick="() => ViewLogs(job)" title="View Logs">📜 Logs</button>
                            <button class="copy-btn" @onclick="() => CopyJob(job)">📋 Copy</button>
                            <button class="retry-btn" @onclick="() => RetryJob(job)">🔄 Retry</button>
                            <button class="delete-btn" @onclick="() => DeleteJob(job.Id)">🗑️ Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Create Job</h3>
                <button class="close-btn" @onclick="CloseModal">✖</button>
            </div>
            <EditForm Model="@jobForm" OnValidSubmit="SubmitJobForm">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label>Customer:</label>
                    <select @bind="jobForm.Customer" class="form-control">
                        <option value="">-- Select customer --</option>
                        @foreach (var customer in customers)
                        {
                            <option value="@customer.Name">@customer.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Registry Server:</label>
                    <select @bind="selectedRegistryId" @bind:after="OnRegistrySelected" class="form-control">
                        <option value="">-- Select registry --</option>
                        @foreach (var registry in registries)
                        {
                            <option value="@registry.Id">@registry.Name (@registry.Server)</option>
                        }
                    </select>
                </div>
                @if (selectedRegistry != null && selectedRegistry.Type == "AzureContainerRegistry")
                {
                    <div class="form-group">
                        <label>Image Repository:</label>
                        @if (isLoadingImages)
                        {
                            <p>Loading images...</p>
                        }
                        else if (registryImages?.Images?.Any() == true)
                        {
                            <select @bind="selectedImageRepository" @bind:after="OnImageRepositorySelected" class="form-control">
                                <option value="">-- Select image repository --</option>
                                @foreach (var image in registryImages.Images)
                                {
                                    <option value="@image.Repository">@image.Repository (@image.Tags.Count tags)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <p class="info-text">No images found in registry</p>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(selectedImageRepository) && selectedImageTags?.Any() == true)
                    {
                        <div class="form-group">
                            <label>Image Tag:</label>
                            <select @bind="selectedImageTag" @bind:after="OnImageTagSelected" class="form-control">
                                <option value="">-- Select tag --</option>
                                @foreach (var tag in selectedImageTags)
                                {
                                    <option value="@tag">@tag</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="form-group">
                        <label>Container Image (auto-filled):</label>
                        <InputText @bind-Value="jobForm.ContainerImage" class="form-control" placeholder="repository:tag" readonly="@(!string.IsNullOrEmpty(selectedImageRepository))" />
                        <small class="info-text">💡 A scoped ACR token will be created automatically for this job</small>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Container Image:</label>
                        <InputText @bind-Value="jobForm.ContainerImage" class="form-control" placeholder="myimage:latest" />
                    </div>
                }
                <div class="form-group">
                    <label>Name:</label>
                    <InputText @bind-Value="jobForm.Name" class="form-control" placeholder="My Job" />
                </div>
                <div class="form-group">
                    <label>Script Path:</label>
                    <InputText @bind-Value="jobForm.ScriptPath" class="form-control" placeholder="/scripts/myscript.ps1" />
                </div>

                <div class="schedule-section">
                    <h4>Schedule</h4>
                    <div class="schedule-type">
                        <label>
                            <input type="radio" name="scheduleType" value="once" @onchange="() => SetScheduleType(false)" checked="@(!useRecurring)" />
                            Run Once
                        </label>
                        <label>
                            <input type="radio" name="scheduleType" value="recurring" @onchange="() => SetScheduleType(true)" checked="@useRecurring" />
                            Recurring (Cron)
                        </label>
                    </div>

                    @if (useRecurring)
                    {
                        <CronScheduler CronExpression="@jobForm.Schedule" CronExpressionChanged="@(EventCallback.Factory.Create<string>(this, value => jobForm.Schedule = value))" />
                    }
                    else
                    {
                        <div class="form-group">
                            <label>Run At:</label>
                            <input type="datetime-local" @bind="scheduledForInput" class="form-control" />
                        </div>
                    }
                </div>

                <div class="parameters-section">
                    <h4>Parameters</h4>
                    <ParameterInput Parameters="@jobForm.Parameters" ParametersChanged="@(EventCallback.Factory.Create<Dictionary<string, string>>(this, value => jobForm.Parameters = value))" />
                </div>

                <div class="modal-footer">
                    @if (isSubmitting)
                    {
                        <div class="loading-indicator">
                            <div class="spinner"></div>
                            <span>@submittingStatus</span>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="cancel-btn" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="submit-btn">Create Job</button>
                    }
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showLogsModal && selectedLogsJob != null)
{
    <div class="modal-overlay" @onclick="CloseLogsModal">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>📜 Logs: @selectedLogsJob.Name</h3>
                <button class="close-btn" @onclick="CloseLogsModal">✖</button>
            </div>
            <div class="logs-modal-content">
                @if (isLoadingLogs)
                {
                    <p>Loading logs...</p>
                }
                else
                {
                    <div class="logs-container">
                        <div class="log-section">
                            <h4>Container Logs</h4>
                            <div class="log-output">
                                @if (!containerLogs.Any())
                                {
                                    <p class="no-logs">No container logs available.</p>
                                }
                                else
                                {
                                    @foreach (var log in containerLogs.OrderBy(l => l.Timestamp))
                                    {
                                        <div class="log-entry log-@log.Level.ToLower()">
                                            <span class="log-timestamp">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                            <span class="log-level">@log.Level</span>
                                            <span class="log-message">@log.Message</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="log-section">
                            <h4>Orchestrator Logs</h4>
                            <div class="log-output">
                                @if (!orchestratorLogs.Any())
                                {
                                    <p class="no-logs">No orchestrator logs available.</p>
                                }
                                else
                                {
                                    @foreach (var log in orchestratorLogs.OrderBy(l => l.Timestamp))
                                    {
                                        <div class="log-entry log-@log.Level.ToLower()">
                                            <span class="log-timestamp">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                            <span class="log-level">@log.Level</span>
                                            <span class="log-message">@log.Message</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<Job> jobs = new();
    private List<Customer> customers = new();
    private List<ContainerRegistry> registries = new();
    private CreateJobRequest jobForm = new() { Parameters = new() };
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string submittingStatus = "";
    private bool showModal = false;
    private bool useRecurring = false;
    private DateTime scheduledForInput = DateTime.Now.AddHours(1);
    private string selectedRegistryId = "";
    private ContainerRegistry? selectedRegistry;
    private ContainerImageListResponse? registryImages;
    private bool isLoadingImages = false;
    private string selectedImageRepository = "";
    private List<string>? selectedImageTags;
    private string selectedImageTag = "";
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadJobs(), LoadCustomers(), LoadRegistries());
        
        // Auto-refresh every 5 seconds
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadJobs();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }

    private async Task OnRegistrySelected()
    {
        selectedRegistry = null;
        registryImages = null;
        selectedImageRepository = "";
        selectedImageTags = null;
        selectedImageTag = "";
        jobForm.RegistryId = null;
        jobForm.ImageRepository = null;
        jobForm.ContainerImage = "";
        
        if (Guid.TryParse(selectedRegistryId, out var registryId))
        {
            selectedRegistry = registries.FirstOrDefault(r => r.Id == registryId);
            if (selectedRegistry != null)
            {
                jobForm.RegistryServer = selectedRegistry.Server;
                jobForm.RegistryUsername = selectedRegistry.Username;
                jobForm.RegistryPassword = selectedRegistry.Password;
                
                // If it's an ACR, load images
                if (selectedRegistry.Type == "AzureContainerRegistry")
                {
                    jobForm.RegistryId = selectedRegistry.Id;
                    await LoadRegistryImages();
                }
            }
        }
    }

    private async Task LoadRegistryImages()
    {
        if (selectedRegistry == null) return;
        
        isLoadingImages = true;
        StateHasChanged();
        
        try
        {
            registryImages = await Api.GetRegistryImages(selectedRegistry.Id);
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load images: {ex.Message}");
        }
        finally
        {
            isLoadingImages = false;
        }
    }

    private void OnImageRepositorySelected()
    {
        selectedImageTags = null;
        selectedImageTag = "";
        
        if (!string.IsNullOrEmpty(selectedImageRepository) && registryImages != null)
        {
            var image = registryImages.Images.FirstOrDefault(i => i.Repository == selectedImageRepository);
            if (image != null)
            {
                selectedImageTags = image.Tags;
                jobForm.ImageRepository = selectedImageRepository;
            }
        }
    }

    private void OnImageTagSelected()
    {
        if (!string.IsNullOrEmpty(selectedImageRepository) && !string.IsNullOrEmpty(selectedImageTag) && selectedRegistry != null)
        {
            jobForm.ContainerImage = $"{selectedRegistry.Server}/{selectedImageRepository}:{selectedImageTag}";
        }
    }

    private async Task LoadJobs()
    {
        isLoading = true;
        try
        {
            jobs = await Api.GetJobs() ?? new();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load jobs: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCustomers()
    {
        try
        {
            customers = await Api.GetCustomers() ?? new();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load customers: {ex.Message}");
        }
    }

    private async Task LoadRegistries()
    {
        try
        {
            registries = await Api.GetRegistries() ?? new();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load registries: {ex.Message}");
        }
    }

    private void OpenCreateModal()
    {
        jobForm = new() { Parameters = new() };
        useRecurring = false;
        scheduledForInput = DateTime.Now.AddHours(1);
        selectedRegistryId = "";
        selectedRegistry = null;
        registryImages = null;
        selectedImageRepository = "";
        selectedImageTags = null;
        selectedImageTag = "";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        jobForm = new() { Parameters = new() };
        selectedRegistryId = "";
        selectedRegistry = null;
        registryImages = null;
        selectedImageRepository = "";
        selectedImageTags = null;
        selectedImageTag = "";
    }

    private void SetScheduleType(bool recurring)
    {
        useRecurring = recurring;
        if (!recurring)
        {
            jobForm.Schedule = null;
        }
    }

    private async Task SubmitJobForm()
    {
        isSubmitting = true;
        submittingStatus = "Creating job...";
        StateHasChanged();
        
        try
        {
            if (!useRecurring)
            {
                jobForm.ScheduledFor = scheduledForInput;
                jobForm.Schedule = null;
            }
            else
            {
                jobForm.ScheduledFor = null;
            }

            // Show specific status for ACR jobs
            if (selectedRegistry?.Type == "AzureContainerRegistry" && !string.IsNullOrEmpty(selectedImageRepository))
            {
                submittingStatus = "Creating ACR scope map...";
                StateHasChanged();
                await Task.Delay(100); // Allow UI to update
            }

            await Api.CreateJob(jobForm);
            await Toast.ShowSuccess("Job created successfully!");
            CloseModal();
            await LoadJobs();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to create job: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteJob(Guid id)
    {
        try
        {
            await Api.DeleteJob(id);
            await Toast.ShowSuccess("Job deleted");
            await LoadJobs();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to delete job: {ex.Message}");
        }
    }

    private void CopyJob(Job job)
    {
        jobForm = new CreateJobRequest
        {
            Name = $"{job.Name} (Copy)",
            Customer = job.Customer,
            ScriptPath = job.ScriptPath,
            ContainerImage = job.ContainerImage,
            RegistryServer = job.RegistryServer,
            RegistryUsername = job.RegistryUsername,
            RegistryPassword = job.RegistryPassword,
            JobType = job.JobType,
            IsWhatIf = job.IsWhatIf,
            Schedule = job.Schedule,
            Parameters = new Dictionary<string, string>(job.Parameters)
        };
        
        useRecurring = !string.IsNullOrEmpty(job.Schedule);
        showModal = true;
    }

    private async Task RetryJob(Job job)
    {
        try
        {
            var retryRequest = new CreateJobRequest
            {
                Name = $"{job.Name} (Retry)",
                Customer = job.Customer,
                ScriptPath = job.ScriptPath,
                ContainerImage = job.ContainerImage,
                RegistryServer = job.RegistryServer,
                RegistryUsername = job.RegistryUsername,
                RegistryPassword = job.RegistryPassword,
                JobType = job.JobType,
                IsWhatIf = job.IsWhatIf,
                Schedule = null,  // One-time retry
                Parameters = new Dictionary<string, string>(job.Parameters)
            };
            
            await Api.CreateJob(retryRequest);
            await Toast.ShowSuccess("Job retry created");
            await LoadJobs();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to retry job: {ex.Message}");
        }
    }

    private Job? selectedLogsJob;
    private List<LogEntry> containerLogs = new();
    private List<LogEntry> orchestratorLogs = new();
    private bool showLogsModal = false;
    private bool isLoadingLogs = false;

    private async Task ViewLogs(Job job)
    {
        selectedLogsJob = job;
        showLogsModal = true;
        isLoadingLogs = true;
        containerLogs = new();
        orchestratorLogs = new();
        StateHasChanged();

        try
        {
            var allLogs = await Api.GetLogs(job.Id) ?? new();
            containerLogs = allLogs.Where(l => l.Source?.Equals("container", StringComparison.OrdinalIgnoreCase) == true).ToList();
            orchestratorLogs = allLogs.Where(l => l.Source?.Equals("orchestrator", StringComparison.OrdinalIgnoreCase) == true).ToList();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load logs: {ex.Message}");
        }
        finally
        {
            isLoadingLogs = false;
        }
    }

    private void CloseLogsModal()
    {
        showLogsModal = false;
        selectedLogsJob = null;
    }
}
