@inject ApiService Api
@inject ToastService Toast

<div class="tab-content">
    <div class="tab-header">
        <h2>Container Registries</h2>
        <button class="cleanup-btn" @onclick="CleanupExpired">🧹 Cleanup Expired</button>
    </div>

    @if (isLoading)
    {
        <p>Loading registries...</p>
    }
    else if (registries == null || !registries.Any())
    {
        <p>No registries found.</p>
    }
    else
    {
        <div class="table-info-bar">
            <span class="record-count">Showing @FilteredRegistries.Count() of @registries.Count records</span>
            @if (HasActiveFilters)
            {
                <button class="clear-filters-btn" @onclick="ClearFilters">Clear Filters</button>
            }
        </div>
        <div class="table-wrapper">
        <table class="sortable-table">
            <thead>
                <tr>
                    <th class="sortable" @onclick='() => Sort("Name")'>
                        <span class="sort-header">Name <span class="sort-icon @GetSortClass("Name")"></span></span>
                    </th>
                    <th class="sortable" @onclick='() => Sort("Server")'>
                        <span class="sort-header">Server <span class="sort-icon @GetSortClass("Server")"></span></span>
                    </th>
                    <th class="sortable" @onclick='() => Sort("Type")'>
                        <span class="sort-header">Type <span class="sort-icon @GetSortClass("Type")"></span></span>
                    </th>
                    <th>Actions</th>
                </tr>
                <tr class="filter-row">
                    <th><input type="text" class="filter-input" placeholder="Filter..." @bind="filterByName" @bind:event="oninput" /></th>
                    <th><input type="text" class="filter-input" placeholder="Filter..." @bind="filterByServer" @bind:event="oninput" /></th>
                    <th>
                        <select class="filter-input" @bind="filterByType">
                            <option value="">All</option>
                            <option value="ACR">ACR</option>
                            <option value="Generic">Generic</option>
                        </select>
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in FilteredRegistries)
                {
                    <tr>
                        <td>@reg.Name</td>
                        <td>@reg.Server</td>
                        <td>@(reg.Type == "AzureContainerRegistry" ? "ACR" : "Generic")</td>
                        <td>
                            @if (reg.Type == "AzureContainerRegistry")
                            {
                                <button class="action-btn" @onclick="() => ViewRegistry(reg)">📋 View</button>
                            }
                            <button class="delete-btn" @onclick="() => DeleteRegistry(reg.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }

    @if (selectedRegistry != null)
    {
        <div class="registry-details">
            <h3>@selectedRegistry.Name - Management</h3>
            <button class="close-btn" @onclick="CloseRegistry">✕ Close</button>
            
            <div class="acr-tabs">
                <button class="@(activeTab == "images" ? "active" : "")" @onclick="SelectImagesTab">Images</button>
                <button class="@(activeTab == "scopemaps" ? "active" : "")" @onclick="SelectScopeMapsTab">Scope Maps</button>
                <button class="@(activeTab == "tokens" ? "active" : "")" @onclick="SelectTokensTab">Tokens</button>
            </div>

            @if (activeTab == "images")
            {
                <div class="tab-panel">
                    @if (isLoadingImages)
                    {
                        <p>Loading images...</p>
                    }
                    else if (images?.Images?.Any() == true)
                    {
                        <table class="images-table">
                            <thead>
                                <tr>
                                    <th>Repository</th>
                                    <th>Tags</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var img in images.Images)
                                {
                                    <tr>
                                        <td>@img.Repository</td>
                                        <td>@string.Join(", ", img.Tags)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="retrieved-at">Retrieved: @images.RetrievedAt.ToLocalTime()</p>
                    }
                    else
                    {
                        <p>No images found.</p>
                    }
                    <button class="refresh-btn" @onclick="LoadImages">🔄 Refresh</button>
                </div>
            }
            else if (activeTab == "scopemaps")
            {
                <div class="tab-panel">
                    @if (isLoadingScopeMaps)
                    {
                        <p>Loading scope maps...</p>
                    }
                    else if (scopeMaps?.Any() == true)
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Tokens</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sm in scopeMaps)
                                {
                                    <tr>
                                        <td>@sm.Name</td>
                                        <td>@sm.Description</td>
                                        <td>@sm.AssociatedTokenIds.Count</td>
                                        <td>
                                            <button class="action-btn" @onclick="() => ViewScopeMapActions(sm)">View</button>
                                            <button class="delete-btn" @onclick="() => DeleteScopeMap(sm.Id)" disabled="@(sm.AssociatedTokenIds.Any())">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No scope maps found.</p>
                    }

                    @if (showCreateScopeMap)
                    {
                        <div class="create-form">
                            <h4>Create Scope Map</h4>
                            <EditForm Model="@newScopeMap" OnValidSubmit="CreateScopeMap">
                                <div class="form-group">
                                    <label>Name:</label>
                                    <InputText @bind-Value="newScopeMap.Name" class="form-control" placeholder="customer-readonly" />
                                </div>
                                <div class="form-group">
                                    <label>Description:</label>
                                    <InputText @bind-Value="newScopeMap.Description" class="form-control" placeholder="Read-only access" />
                                </div>
                                <div class="form-group">
                                    <label>Repositories (comma-separated):</label>
                                    <InputText @bind-Value="repositoriesInput" class="form-control" placeholder="customer-scripts/alpha, base-images/powershell" />
                                </div>
                                <div class="form-group">
                                    <label>Actions:</label>
                                    <div class="checkbox-group">
                                        <label><InputCheckbox @bind-Value="actionRead" /> content/read (Pull)</label>
                                        <label><InputCheckbox @bind-Value="actionWrite" /> content/write (Push)</label>
                                        <label><InputCheckbox @bind-Value="actionDelete" /> content/delete</label>
                                        <label><InputCheckbox @bind-Value="actionMetadataRead" /> metadata/read</label>
                                    </div>
                                </div>
                                <button type="submit" class="add-btn" disabled="@isSubmittingScopeMap">Create</button>
                                <button type="button" class="cancel-btn" @onclick='() => showCreateScopeMap = false'>Cancel</button>
                            </EditForm>
                        </div>
                    }
                    else
                    {
                        <button class="add-btn" @onclick='() => showCreateScopeMap = true'>➕ Create Scope Map</button>
                    }
                </div>
            }
            else if (activeTab == "tokens")
            {
                <div class="tab-panel">
                    @if (isLoadingTokens)
                    {
                        <p>Loading tokens...</p>
                    }
                    else if (tokens?.Any() == true)
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th>Expires</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var token in tokens)
                                {
                                    <tr class="@(token.Status == "Expired" ? "expired" : "")">
                                        <td>@token.Name</td>
                                        <td>@token.Status</td>
                                        <td>@token.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@(token.ExpiresAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                                        <td>
                                            @if (token.Status == "Active")
                                            {
                                                <button class="action-btn" @onclick="() => DisableToken(token.Id)">Disable</button>
                                            }
                                            <button class="delete-btn" @onclick="() => DeleteToken(token.Id)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No tokens found.</p>
                    }

                    @if (showCreateToken)
                    {
                        <div class="create-form">
                            <h4>Create Token</h4>
                            <EditForm Model="@newToken" OnValidSubmit="CreateToken">
                                <div class="form-group">
                                    <label>Name:</label>
                                    <InputText @bind-Value="newToken.Name" class="form-control" placeholder="job-12345-token" />
                                </div>
                                <div class="form-group">
                                    <label>Scope Map:</label>
                                    <InputSelect @bind-Value="newToken.ScopeMapId" class="form-control">
                                        <option value="@Guid.Empty">Select scope map...</option>
                                        @if (scopeMaps != null)
                                        {
                                            @foreach (var sm in scopeMaps)
                                            {
                                                <option value="@sm.Id">@sm.Name</option>
                                            }
                                        }
                                    </InputSelect>
                                </div>
                                <div class="form-group">
                                    <label>Expiry (days):</label>
                                    <InputNumber @bind-Value="newToken.ExpiryInDays" class="form-control" placeholder="7" />
                                </div>
                                <button type="submit" class="add-btn" disabled="@isSubmittingToken">Create</button>
                                <button type="button" class="cancel-btn" @onclick='() => showCreateToken = false'>Cancel</button>
                            </EditForm>

                            @if (createdTokenPassword != null)
                            {
                                <div class="token-password">
                                    <h4>⚠️ Token Created - Save Password!</h4>
                                    <p><strong>Username:</strong> @createdTokenUsername</p>
                                    <p><strong>Password:</strong> <code>@createdTokenPassword</code></p>
                                    <button @onclick="CopyPassword">📋 Copy Password</button>
                                    <p class="warning">This password will only be shown once!</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <button class="add-btn" @onclick='async () => { showCreateToken = true; await LoadScopeMaps(); }'>➕ Create Token</button>
                    }
                </div>
            }
        </div>
    }

    <div class="add-registry-form">
        <h3>Add New Registry</h3>
        <EditForm Model="@newRegistry" OnValidSubmit="CreateRegistry">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <div class="form-group">
                    <label>Type:</label>
                    <InputSelect @bind-Value="newRegistry.Type" class="form-control">
                        <option value="Generic">Generic</option>
                        <option value="AzureContainerRegistry">Azure Container Registry</option>
                    </InputSelect>
                </div>
                <div class="form-group">
                    <label>Name:</label>
                    <InputText @bind-Value="newRegistry.Name" class="form-control" placeholder="myregistry" />
                </div>
                <div class="form-group">
                    <label>Server:</label>
                    <InputText @bind-Value="newRegistry.Server" class="form-control" placeholder="myregistry.azurecr.io" />
                </div>
                
                @if (newRegistry.Type == "AzureContainerRegistry")
                {
                    <div class="form-group">
                        <label>Subscription ID:</label>
                        <InputText @bind-Value="newRegistry.SubscriptionId" class="form-control" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                    </div>
                    <div class="form-group">
                        <label>Resource Group:</label>
                        <InputText @bind-Value="newRegistry.ResourceGroup" class="form-control" placeholder="my-resource-group" />
                    </div>
                    <div class="form-group">
                        <label>
                            <InputCheckbox @bind-Value="newRegistry.UseGraphManagement" />
                            Enable Token Management
                        </label>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Username:</label>
                        <InputText @bind-Value="newRegistry.Username" class="form-control" placeholder="username" />
                    </div>
                    <div class="form-group">
                        <label>Password:</label>
                        <InputText @bind-Value="newRegistry.Password" type="password" class="form-control" placeholder="password" />
                    </div>
                }
            </div>
            <button type="submit" class="add-btn" disabled="@isSubmitting">Add Registry</button>
        </EditForm>
    </div>
</div>

@code {
    private List<ContainerRegistry> registries = new();
    private CreateRegistryRequest newRegistry = new();
    private bool isLoading = true;
    private bool isSubmitting = false;

    // Sorting
    private string sortColumn = "Name";
    private bool sortAscending = true;

    // Filtering
    private string filterByName = "";
    private string filterByServer = "";
    private string filterByType = "";

    private bool HasActiveFilters => !string.IsNullOrEmpty(filterByName) || !string.IsNullOrEmpty(filterByServer) || !string.IsNullOrEmpty(filterByType);

    private IEnumerable<ContainerRegistry> FilteredRegistries
    {
        get
        {
            var result = registries.AsEnumerable();

            if (!string.IsNullOrEmpty(filterByName))
                result = result.Where(r => r.Name?.Contains(filterByName, StringComparison.OrdinalIgnoreCase) == true);
            if (!string.IsNullOrEmpty(filterByServer))
                result = result.Where(r => r.Server?.Contains(filterByServer, StringComparison.OrdinalIgnoreCase) == true);
            if (!string.IsNullOrEmpty(filterByType))
            {
                var isAcr = filterByType.Equals("ACR", StringComparison.OrdinalIgnoreCase);
                result = result.Where(r => (r.Type == "AzureContainerRegistry") == isAcr);
            }

            result = sortColumn switch
            {
                "Name" => sortAscending ? result.OrderBy(r => r.Name) : result.OrderByDescending(r => r.Name),
                "Server" => sortAscending ? result.OrderBy(r => r.Server) : result.OrderByDescending(r => r.Server),
                "Type" => sortAscending ? result.OrderBy(r => r.Type) : result.OrderByDescending(r => r.Type),
                _ => result
            };

            return result;
        }
    }

    private void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string GetSortClass(string column)
    {
        if (sortColumn != column) return "none";
        return sortAscending ? "active asc" : "active desc";
    }

    private void ClearFilters()
    {
        filterByName = "";
        filterByServer = "";
        filterByType = "";
    }

    // ACR Management
    private ContainerRegistry? selectedRegistry;
    private string activeTab = "images";
    private ContainerImageListResponse? images;
    private List<AcrScopeMap>? scopeMaps;
    private List<AcrToken>? tokens;
    private bool isLoadingImages;
    private bool isLoadingScopeMaps;
    private bool isLoadingTokens;

    // Scope Map Creation
    private bool showCreateScopeMap;
    private bool isSubmittingScopeMap;
    private CreateScopeMapRequest newScopeMap = new();
    private string repositoriesInput = "";
    private bool actionRead = true;
    private bool actionWrite = false;
    private bool actionDelete = false;
    private bool actionMetadataRead = true;

    // Token Creation
    private bool showCreateToken;
    private bool isSubmittingToken;
    private CreateTokenRequest newToken = new();
    private string? createdTokenPassword;
    private string? createdTokenUsername;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegistries();
    }

    private async Task LoadRegistries()
    {
        isLoading = true;
        try
        {
            registries = await Api.GetRegistries() ?? new();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load registries: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateRegistry()
    {
        isSubmitting = true;
        try
        {
            await Api.CreateRegistry(newRegistry);
            await Toast.ShowSuccess("Registry created");
            newRegistry = new();
            await LoadRegistries();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to create registry: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteRegistry(Guid id)
    {
        try
        {
            await Api.DeleteRegistry(id.ToString());
            await Toast.ShowSuccess("Registry deleted");
            if (selectedRegistry?.Id == id)
            {
                selectedRegistry = null;
            }
            await LoadRegistries();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to delete registry: {ex.Message}");
        }
    }

    private async Task ViewRegistry(ContainerRegistry registry)
    {
        selectedRegistry = registry;
        activeTab = "images";
        await LoadImages();
    }

    private async Task SelectImagesTab()
    {
        activeTab = "images";
        if (images == null)
        {
            await LoadImages();
        }
    }

    private async Task SelectScopeMapsTab()
    {
        activeTab = "scopemaps";
        if (scopeMaps == null)
        {
            await LoadScopeMaps();
        }
    }

    private async Task SelectTokensTab()
    {
        activeTab = "tokens";
        if (tokens == null)
        {
            await LoadTokens();
        }
    }

    private void CloseRegistry()
    {
        selectedRegistry = null;
        images = null;
        scopeMaps = null;
        tokens = null;
    }

    private async Task LoadImages()
    {
        if (selectedRegistry == null) return;
        isLoadingImages = true;
        try
        {
            images = await Api.GetRegistryImages(selectedRegistry.Id);
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load images: {ex.Message}");
        }
        finally
        {
            isLoadingImages = false;
        }
    }

    private async Task LoadScopeMaps()
    {
        if (selectedRegistry == null) return;
        isLoadingScopeMaps = true;
        try
        {
            scopeMaps = await Api.GetScopeMaps(selectedRegistry.Id);
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load scope maps: {ex.Message}");
        }
        finally
        {
            isLoadingScopeMaps = false;
        }
    }

    private async Task LoadTokens()
    {
        if (selectedRegistry == null) return;
        isLoadingTokens = true;
        try
        {
            tokens = await Api.GetTokens(selectedRegistry.Id);
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load tokens: {ex.Message}");
        }
        finally
        {
            isLoadingTokens = false;
        }
    }

    private async Task ViewScopeMapActions(AcrScopeMap scopeMap)
    {
        var actions = string.Join("\n", scopeMap.Actions);
        await Toast.ShowInfo($"Scope Map Actions:\n{actions}");
    }

    private async Task CreateScopeMap()
    {
        if (selectedRegistry == null) return;
        isSubmittingScopeMap = true;
        try
        {
            newScopeMap.Repositories = repositoriesInput.Split(',').Select(r => r.Trim()).Where(r => !string.IsNullOrEmpty(r)).ToList();
            newScopeMap.Actions = new List<string>();
            if (actionRead) newScopeMap.Actions.Add("content/read");
            if (actionWrite) newScopeMap.Actions.Add("content/write");
            if (actionDelete) newScopeMap.Actions.Add("content/delete");
            if (actionMetadataRead) newScopeMap.Actions.Add("metadata/read");

            await Api.CreateScopeMap(selectedRegistry.Id, newScopeMap);
            await Toast.ShowSuccess("Scope map created");
            newScopeMap = new();
            repositoriesInput = "";
            actionRead = true;
            actionWrite = false;
            actionDelete = false;
            actionMetadataRead = true;
            showCreateScopeMap = false;
            await LoadScopeMaps();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to create scope map: {ex.Message}");
        }
        finally
        {
            isSubmittingScopeMap = false;
        }
    }

    private async Task DeleteScopeMap(Guid id)
    {
        try
        {
            await Api.DeleteScopeMap(id);
            await Toast.ShowSuccess("Scope map deleted");
            await LoadScopeMaps();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to delete scope map: {ex.Message}");
        }
    }

    private async Task CreateToken()
    {
        if (selectedRegistry == null) return;
        isSubmittingToken = true;
        createdTokenPassword = null;
        try
        {
            var response = await Api.CreateToken(selectedRegistry.Id, newToken);
            if (response != null)
            {
                createdTokenPassword = response.Password;
                createdTokenUsername = response.Username;
                await Toast.ShowSuccess("Token created - Save the password!");
                newToken = new();
                await LoadTokens();
            }
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to create token: {ex.Message}");
        }
        finally
        {
            isSubmittingToken = false;
        }
    }

    private async Task DisableToken(Guid id)
    {
        try
        {
            await Api.DisableToken(id);
            await Toast.ShowSuccess("Token disabled");
            await LoadTokens();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to disable token: {ex.Message}");
        }
    }

    private async Task DeleteToken(Guid id)
    {
        try
        {
            await Api.DeleteToken(id);
            await Toast.ShowSuccess("Token deleted");
            await LoadTokens();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to delete token: {ex.Message}");
        }
    }

    private async Task CleanupExpired()
    {
        try
        {
            var result = await Api.CleanupRegistry();
            if (result != null)
            {
                await Toast.ShowSuccess($"Cleanup complete: {result.TokensDeleted} tokens, {result.ScopeMapsDeleted} scope maps deleted");
                if (selectedRegistry != null)
                {
                    await LoadTokens();
                    await LoadScopeMaps();
                }
            }
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to cleanup: {ex.Message}");
        }
    }

    private async Task CopyPassword()
    {
        // In a real implementation, use JSInterop to copy to clipboard
        await Toast.ShowSuccess("Copy the password above manually");
    }
}
