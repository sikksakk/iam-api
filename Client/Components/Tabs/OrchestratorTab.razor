@inject ApiService Api
@inject ToastService Toast
@implements IDisposable

<div class="tab-content">
    <div class="tab-header">
        <h2>Orchestrators</h2>
        <button class="cleanup-btn" @onclick="CleanupOrchestrators" disabled="@isLoading">🧹 Cleanup Dead Orchestrators</button>
    </div>

    @if (isLoading)
    {
        <p>Loading orchestrators...</p>
    }
    else if (orchestrators == null || !orchestrators.Any())
    {
        <p>No orchestrators found.</p>
    }
    else
    {
        <div class="table-info-bar">
            <span class="record-count">Showing @FilteredOrchestrators.Count() of @orchestrators.Count records</span>
            @if (HasActiveFilters)
            {
                <button class="clear-filters-btn" @onclick="ClearFilters">Clear Filters</button>
            }
        </div>
        <div class="table-wrapper">
        <table class="sortable-table">
            <thead>
                <tr>
                    <th class="sortable" @onclick='() => Sort("Id")'>
                        <span class="sort-header">ID <span class="sort-icon @GetSortClass("Id")"></span></span>
                    </th>
                    <th class="sortable" @onclick='() => Sort("CustomerName")'>
                        <span class="sort-header">Customer <span class="sort-icon @GetSortClass("CustomerName")"></span></span>
                    </th>
                    <th class="sortable" @onclick='() => Sort("HostName")'>
                        <span class="sort-header">Host <span class="sort-icon @GetSortClass("HostName")"></span></span>
                    </th>
                    <th class="sortable" @onclick='() => Sort("LastHeartbeat")'>
                        <span class="sort-header">Last Heartbeat <span class="sort-icon @GetSortClass("LastHeartbeat")"></span></span>
                    </th>
                    <th class="sortable" @onclick='() => Sort("Status")'>
                        <span class="sort-header">Status <span class="sort-icon @GetSortClass("Status")"></span></span>
                    </th>
                    <th>Actions</th>
                </tr>
                <tr class="filter-row">
                    <th><input type="text" class="filter-input" placeholder="Filter..." @bind="filterById" @bind:event="oninput" /></th>
                    <th><input type="text" class="filter-input" placeholder="Filter..." @bind="filterByCustomer" @bind:event="oninput" /></th>
                    <th><input type="text" class="filter-input" placeholder="Filter..." @bind="filterByHost" @bind:event="oninput" /></th>
                    <th></th>
                    <th>
                        <select class="filter-input" @bind="filterByStatus">
                            <option value="">All</option>
                            <option value="Alive">Alive</option>
                            <option value="Stale">Stale</option>
                            <option value="Dead">Dead</option>
                        </select>
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var orch in FilteredOrchestrators)
                {
                    var status = GetStatus(orch);
                    <tr class="@(status.isAlive ? "" : "dead-orchestrator")">
                        <td>@orch.Id.Substring(0, Math.Min(12, orch.Id.Length))</td>
                        <td>@orch.CustomerName</td>
                        <td>@orch.HostName</td>
                        <td>@orch.LastHeartbeat.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            <span class="status-badge @status.cssClass">@status.text</span>
                            @if (orch.PendingUpdate)
                            {
                                <span class="status-badge status-pending" title="Update pending">🔄</span>
                            }
                        </td>
                        <td>
                            <button class="update-btn" @onclick="() => RequestUpdate(orch.Id)" disabled="@(!status.isAlive || orch.PendingUpdate)" title="Request Update">🔄 Update</button>
                            <button class="delete-btn" @onclick="() => DeleteOrchestrator(orch.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private List<Orchestrator> orchestrators = new();
    private bool isLoading = true;
    private System.Threading.Timer? refreshTimer;

    // Sorting
    private string sortColumn = "LastHeartbeat";
    private bool sortAscending = false;

    // Filtering
    private string filterById = "";
    private string filterByCustomer = "";
    private string filterByHost = "";
    private string filterByStatus = "";

    private bool HasActiveFilters => !string.IsNullOrEmpty(filterById) || !string.IsNullOrEmpty(filterByCustomer) || 
                                      !string.IsNullOrEmpty(filterByHost) || !string.IsNullOrEmpty(filterByStatus);

    private IEnumerable<Orchestrator> FilteredOrchestrators
    {
        get
        {
            var result = orchestrators.AsEnumerable();

            if (!string.IsNullOrEmpty(filterById))
                result = result.Where(o => o.Id.Contains(filterById, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(filterByCustomer))
                result = result.Where(o => o.CustomerName.Contains(filterByCustomer, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(filterByHost))
                result = result.Where(o => o.HostName.Contains(filterByHost, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(filterByStatus))
                result = result.Where(o => GetStatus(o).text.Equals(filterByStatus, StringComparison.OrdinalIgnoreCase));

            result = sortColumn switch
            {
                "Id" => sortAscending ? result.OrderBy(o => o.Id) : result.OrderByDescending(o => o.Id),
                "CustomerName" => sortAscending ? result.OrderBy(o => o.CustomerName) : result.OrderByDescending(o => o.CustomerName),
                "HostName" => sortAscending ? result.OrderBy(o => o.HostName) : result.OrderByDescending(o => o.HostName),
                "LastHeartbeat" => sortAscending ? result.OrderBy(o => o.LastHeartbeat) : result.OrderByDescending(o => o.LastHeartbeat),
                "Status" => sortAscending ? result.OrderBy(o => GetStatus(o).text) : result.OrderByDescending(o => GetStatus(o).text),
                _ => result
            };

            return result;
        }
    }

    private void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string GetSortClass(string column)
    {
        if (sortColumn != column) return "none";
        return sortAscending ? "active asc" : "active desc";
    }

    private void ClearFilters()
    {
        filterById = "";
        filterByCustomer = "";
        filterByHost = "";
        filterByStatus = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrchestrators();
        
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadOrchestrators();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }

    private async Task LoadOrchestrators()
    {
        isLoading = true;
        try
        {
            orchestrators = await Api.GetOrchestrators() ?? new();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load orchestrators: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private (bool isAlive, string text, string cssClass) GetStatus(Orchestrator orch)
    {
        var diff = DateTime.UtcNow - orch.LastHeartbeat;
        var isOnline = orch.IsOnline ?? (diff.TotalMinutes < 1);
        
        if (isOnline) return (true, "Alive", "status-alive");
        if (diff.TotalMinutes < 5) return (false, "Stale", "status-stale");
        return (false, "Dead", "status-dead");
    }

    private async Task DeleteOrchestrator(string id)
    {
        try
        {
            await Api.DeleteOrchestrator(id);
            await Toast.ShowSuccess("Orchestrator deleted");
            await LoadOrchestrators();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to delete orchestrator: {ex.Message}");
        }
    }

    private async Task CleanupOrchestrators()
    {
        try
        {
            var result = await Api.CleanupOrchestrators();
            await Toast.ShowSuccess($"Cleaned up {result?.RemovedCount ?? 0} orchestrators");
            await LoadOrchestrators();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Cleanup failed: {ex.Message}");
        }
    }

    private async Task RequestUpdate(string id)
    {
        try
        {
            await Api.RequestOrchestratorUpdate(id);
            await Toast.ShowSuccess("Update requested - orchestrator will restart on next cycle");
            await LoadOrchestrators();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to request update: {ex.Message}");
        }
    }
}
