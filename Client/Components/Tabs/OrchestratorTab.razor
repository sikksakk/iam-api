@inject ApiService Api
@inject ToastService Toast

<div class="tab-content">
    <div class="tab-header">
        <h2>Orchestrators</h2>
        <button class="cleanup-btn" @onclick="CleanupOrchestrators" disabled="@isLoading">🧹 Cleanup Dead Orchestrators</button>
    </div>

    @if (isLoading)
    {
        <p>Loading orchestrators...</p>
    }
    else if (orchestrators == null || !orchestrators.Any())
    {
        <p>No orchestrators found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Host</th>
                    <th>Last Heartbeat</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var orch in orchestrators)
                {
                    var status = GetStatus(orch);
                    <tr class="@(status.isAlive ? "" : "dead-orchestrator")">
                        <td>@orch.Id.Substring(0, Math.Min(12, orch.Id.Length))</td>
                        <td>@orch.CustomerName</td>
                        <td>@orch.HostName</td>
                        <td>@orch.LastHeartbeat.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            <span class="status-badge @status.cssClass">@status.text</span>
                        </td>
                        <td>
                            <button class="delete-btn" @onclick="() => DeleteOrchestrator(orch.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Orchestrator> orchestrators = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrchestrators();
    }

    private async Task LoadOrchestrators()
    {
        isLoading = true;
        try
        {
            orchestrators = await Api.GetOrchestrators();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to load orchestrators: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private (bool isAlive, string text, string cssClass) GetStatus(Orchestrator orch)
    {
        var diff = DateTime.Now - orch.LastHeartbeat;
        if (diff.TotalMinutes < 2)
            return (true, "Alive", "status-alive");
        if (diff.TotalMinutes < 5)
            return (true, "Stale", "status-stale");

        return (false, "Dead", "status-dead");
    }

    private async Task DeleteOrchestrator(string id)
    {
        try
        {
            await Api.DeleteOrchestrator(id);
            await Toast.ShowSuccess("Orchestrator deleted");
            await LoadOrchestrators();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Failed to delete orchestrator: {ex.Message}");
        }
    }

    private async Task CleanupOrchestrators()
    {
        try
        {
            var result = await Api.CleanupOrchestrators();
            await Toast.ShowSuccess($"Cleaned up {result?.RemovedCount ?? 0} orchestrators");
            await LoadOrchestrators();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Cleanup failed: {ex.Message}");
        }
    }
}
