@code {
    [Parameter]
    public string CronExpression { get; set; } = "";

    [Parameter]
    public EventCallback<string> CronExpressionChanged { get; set; }

    private bool[] selectedDays = new bool[7]; // Mon-Sun (UI order)
    private List<(int Hour, int Minute)> scheduledTimes = new() { (0, 0) };
    private string cronPreview = "";
    private readonly string[] dayNames = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    
    // NCrontab uses: 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
    // UI index:      0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri, 5=Sat, 6=Sun
    // Mapping: UI index -> cron value
    private static readonly int[] UiToCron = new[] { 1, 2, 3, 4, 5, 6, 0 }; // Mon=1, Tue=2, ... Sat=6, Sun=0
    private static readonly int[] CronToUi = new[] { 6, 0, 1, 2, 3, 4, 5 }; // Cron 0(Sun)->UI 6, Cron 1(Mon)->UI 0, etc.

    protected override void OnInitialized()
    {
        ParseCronExpression(CronExpression);
        _ = UpdateCronExpression();
    }

    private void ParseCronExpression(string cron)
    {
        if (string.IsNullOrEmpty(cron)) return;

        var parts = cron.Split(' ');
        if (parts.Length == 5)
        {
            // Parse multiple minutes and hours
            var minutes = ParseCronField(parts[0]);
            var hours = ParseCronField(parts[1]);
            
            // Build time combinations
            scheduledTimes.Clear();
            foreach (var h in hours)
            {
                foreach (var m in minutes)
                {
                    scheduledTimes.Add((h, m));
                }
            }
            
            // If no times parsed, add default
            if (!scheduledTimes.Any())
            {
                scheduledTimes.Add((0, 0));
            }
            
            // Sort by hour then minute
            scheduledTimes = scheduledTimes.OrderBy(t => t.Hour).ThenBy(t => t.Minute).ToList();

            if (parts[4] != "*")
            {
                var days = parts[4].Split(',');
                foreach (var day in days)
                {
                    if (int.TryParse(day, out int cronDay) && cronDay >= 0 && cronDay <= 6)
                    {
                        selectedDays[CronToUi[cronDay]] = true;
                    }
                }
            }
        }
    }

    private List<int> ParseCronField(string field)
    {
        var result = new List<int>();
        if (field == "*") return result;
        
        var parts = field.Split(',');
        foreach (var part in parts)
        {
            if (int.TryParse(part.Trim(), out int value))
            {
                result.Add(value);
            }
        }
        return result.Distinct().OrderBy(x => x).ToList();
    }

    private void ToggleDay(int index)
    {
        selectedDays[index] = !selectedDays[index];
        _ = UpdateCronExpression();
    }

    private void AddTime()
    {
        // Add a new time slot, defaulting to the next hour after the last entry
        var lastTime = scheduledTimes.LastOrDefault();
        var newHour = (lastTime.Hour + 1) % 24;
        scheduledTimes.Add((newHour, 0));
        scheduledTimes = scheduledTimes.OrderBy(t => t.Hour).ThenBy(t => t.Minute).ToList();
        _ = UpdateCronExpression();
    }

    private void RemoveTime(int index)
    {
        if (scheduledTimes.Count > 1)
        {
            scheduledTimes.RemoveAt(index);
            _ = UpdateCronExpression();
        }
    }

    private void OnHourChanged(int index, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int h) && h >= 0 && h <= 23)
        {
            var current = scheduledTimes[index];
            scheduledTimes[index] = (h, current.Minute);
            scheduledTimes = scheduledTimes.OrderBy(t => t.Hour).ThenBy(t => t.Minute).ToList();
            _ = UpdateCronExpression();
        }
    }

    private void OnMinuteChanged(int index, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m) && m >= 0 && m <= 59)
        {
            var current = scheduledTimes[index];
            scheduledTimes[index] = (current.Hour, m);
            scheduledTimes = scheduledTimes.OrderBy(t => t.Hour).ThenBy(t => t.Minute).ToList();
            _ = UpdateCronExpression();
        }
    }

    private async Task UpdateCronExpression()
    {
        var cronDays = selectedDays
            .Select((selected, uiIndex) => selected ? UiToCron[uiIndex].ToString() : null)
            .Where(d => d != null)
            .ToList();

        var dayPart = cronDays.Any() ? string.Join(",", cronDays) : "*";
        
        // Get unique hours and minutes
        var hours = scheduledTimes.Select(t => t.Hour).Distinct().OrderBy(h => h).ToList();
        var minutes = scheduledTimes.Select(t => t.Minute).Distinct().OrderBy(m => m).ToList();
        
        // Build cron expression
        // If we have multiple distinct time combinations, we need to check if they can be expressed as hour,minute combinations
        // For simplicity, we'll use the cron format: minute1,minute2 hour1,hour2 * * days
        // This creates a cross-product, so we only do this if user is OK with all combinations
        // For exact times, we'll note this in the preview
        
        var minutePart = string.Join(",", minutes);
        var hourPart = string.Join(",", hours);
        
        var cron = $"{minutePart} {hourPart} * * {dayPart}";
        
        cronPreview = BuildHumanReadable();
        CronExpression = cron;
        await CronExpressionChanged.InvokeAsync(cron);
    }

    private string BuildHumanReadable()
    {
        var days = selectedDays
            .Select((selected, index) => selected ? dayNames[index] : null)
            .Where(d => d != null)
            .ToList();

        var times = scheduledTimes.Select(t => $"{t.Hour:D2}:{t.Minute:D2}").ToList();
        var timeStr = times.Count == 1 ? times[0] : string.Join(", ", times);

        if (!days.Any())
            return $"Every day at {timeStr}";

        return $"Every {string.Join(", ", days)} at {timeStr}";
    }
}

<div class="cron-scheduler">
    <div class="day-selector">
        <label>Days:</label>
        <div class="day-buttons">
            @for (int i = 0; i < 7; i++)
            {
                var index = i; // Capture for lambda
                <button type="button" 
                        class="day-btn @(selectedDays[index] ? "active" : "")" 
                        @onclick="() => ToggleDay(index)">
                    @dayNames[index]
                </button>
            }
        </div>
    </div>

    <div class="times-selector">
        <label>Times:</label>
        <div class="times-list">
            @for (int i = 0; i < scheduledTimes.Count; i++)
            {
                var index = i;
                var time = scheduledTimes[index];
                <div class="time-entry">
                    <div class="time-inputs">
                        <input type="number" 
                               min="0" 
                               max="23" 
                               value="@time.Hour" 
                               @onchange="(e) => OnHourChanged(index, e)" 
                               class="time-input" />
                        <span>:</span>
                        <input type="number" 
                               min="0" 
                               max="59" 
                               value="@time.Minute" 
                               @onchange="(e) => OnMinuteChanged(index, e)" 
                               class="time-input" />
                    </div>
                    @if (scheduledTimes.Count > 1)
                    {
                        <button type="button" class="remove-time-btn" @onclick="() => RemoveTime(index)" title="Remove this time">✕</button>
                    }
                </div>
            }
        </div>
        <button type="button" class="add-time-btn" @onclick="AddTime">➕ Add Time</button>
    </div>

    <div class="cron-preview">
        <label>Schedule:</label>
        <div class="preview-text">@cronPreview</div>
    </div>
</div>
